{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 leads.py profile)",
      "Bash(python3 leads.py profile-save *)",
      "Bash(python3 leads.py rubric)",
      "Bash(python3 leads.py known)",
      "Bash(python3 leads.py watch)",
      "Bash(python3 leads.py add *)",
      "Bash(python3 leads.py digest *)",
      "Bash(python3 leads.py projects-import *)",
      "Bash(python3 leads.py project-save *)"
    ]
  }
}
